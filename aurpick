#!/bin/bash
# aurpick - Interactive AUR package version picker
# License: MIT
# Usage: aurpick <package-name>

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

LAST_FAILED_SOURCES=()
LAST_INTEGRITY_FAILURE=false
AURPICK_HTTP_USER_AGENT='Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0'

# Check if running as root
if [[ $EUID -eq 0 ]]; then
    echo -e "${RED}==>${NC} DO NOT run this script as root" >&2
    echo -e "${RED}==>${NC} makepkg refuses to run as root for security reasons" >&2
    exit 1
fi

# Print colored messages
info() { echo -e "${BLUE}==>${NC} $*"; }
success() { echo -e "${GREEN}==>${NC} $*"; }
warning() { echo -e "${YELLOW}==>${NC} $*"; }
error() { echo -e "${RED}==>${NC} $*" >&2; }

# Shared curl wrapper for consistent timeouts and User-Agent
curl_request() {
    curl -A "$AURPICK_HTTP_USER_AGENT" "$@"
}

# Probe whether a live source URL is still reachable
curl_probe_url() {
    local url="$1"

    curl_request -fsIL --connect-timeout 10 --max-time 20 "$url" >/dev/null 2>&1 || \
        curl_request -fsL --range 0-0 --connect-timeout 10 --max-time 20 "$url" >/dev/null 2>&1
}

# Query Wayback CDX with retries to reduce transient failures
curl_wayback_cdx() {
    local url="$1"

    curl_request -fsL --get \
        --retry 2 \
        --retry-delay 1 \
        --retry-all-errors \
        --connect-timeout 15 \
        --max-time 60 \
        --data-urlencode "url=$url" \
        --data-urlencode "output=json" \
        --data-urlencode "fl=timestamp,original,statuscode,mimetype,length" \
        --data-urlencode "filter=statuscode:200" \
        --data-urlencode "limit=-5" \
        "https://web.archive.org/cdx/search/cdx"
}

# Download a file to disk with consistent retry policy
curl_download_file() {
    local output_path="$1"
    local url="$2"

    curl_request -fL --connect-timeout 15 --retry 2 -o "$output_path" "$url"
}

# Print a short summary of which source files failed integrity checks
summarize_failed_sources() {
    local output="$1"
    local line

    LAST_FAILED_SOURCES=()
    LAST_INTEGRITY_FAILURE=false

    while IFS= read -r line; do
        [[ $line =~ ^[[:space:]]*([^[:space:]].*)[[:space:]]+\.\.\.[[:space:]]+FAILED$ ]] || continue
        LAST_FAILED_SOURCES+=("${BASH_REMATCH[1]}")
    done <<< "$output"

    [[ ${#LAST_FAILED_SOURCES[@]} -gt 0 ]] || return 0
    LAST_INTEGRITY_FAILURE=true
    warning "Integrity check failed for:"

    local failed_source
    for failed_source in "${LAST_FAILED_SOURCES[@]}"; do
        warning "  - $failed_source"
    done
}

# Run makepkg while preserving its output for post-failure summaries
run_makepkg_logged() {
    local output
    local status

    LAST_FAILED_SOURCES=()
    LAST_INTEGRITY_FAILURE=false

    output=$("$@" 2>&1)
    status=$?
    printf '%s\n' "$output"

    if [[ $status -ne 0 ]]; then
        summarize_failed_sources "$output"
    fi

    return $status
}

# Extract a source filename and URL from a PKGBUILD source entry
parse_source_entry() {
    local entry="$1"
    local filename=""
    local url="$entry"

    if [[ "$entry" == *::* ]]; then
        filename=${entry%%::*}
        url=${entry#*::}
    fi

    if [[ -z "$filename" ]]; then
        filename=${url##*/}
        filename=${filename%%\?*}
    fi

    printf '%s\n%s\n' "$filename" "$url"
}

# Read source arrays from the current PKGBUILD, including arch-specific entries
collect_pkgbuild_sources() {
    local arch
    arch=$(uname -m)

    (
        # shellcheck source=/dev/null
        source ./PKGBUILD 2>/dev/null || exit 1

        local array_name
        local entries=()
        for array_name in source "source_${arch}"; do
            if declare -p "$array_name" &>/dev/null; then
                eval "entries=(\"\${${array_name}[@]}\")"
                printf '%s\n' "${entries[@]}"
            fi
        done
    )
}

# Check whether a source URL is still reachable from the live site
source_url_is_reachable() {
    local url="$1"

    curl_probe_url "$url"
}

# Return candidate raw Wayback URLs from the CDX index, newest first
get_wayback_snapshot_urls() {
    local url="$1"
    local response
    local payload
    local snapshot_pattern='\["([0-9]{14})","([^"]+)"'

    response=$(curl_wayback_cdx "$url") || {
        warning "Failed to query Wayback CDX index"
        return 1
    }
    response=${response//$'\n'/ }

    [[ "$response" =~ \[\[ ]] || {
        warning "Wayback CDX returned an unexpected response"
        return 1
    }

    payload=${response#*],}
    while [[ "$payload" =~ $snapshot_pattern ]]; do
        printf 'https://web.archive.org/web/%sid_/%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        payload=${payload#*"${BASH_REMATCH[0]}"}
    done
}

# Download a source file from Wayback into the provided source cache directory
download_wayback_source() {
    local url="$1"
    local filename="$2"
    local srcdest_dir="$3"
    local archive_url
    local tmpfile
    local attempt=0
    local total=0
    local candidates=()

    tmpfile="$srcdest_dir/$filename.part"

    mapfile -t candidates < <(get_wayback_snapshot_urls "$url")
    total=${#candidates[@]}

    for archive_url in "${candidates[@]}"; do
        [[ -n "$archive_url" ]] || continue
        ((attempt++))

        if [[ "$archive_url" =~ /web/([0-9]{14})id_/ ]]; then
            info "Trying Wayback snapshot $attempt/$total: ${BASH_REMATCH[1]}"
        else
            info "Trying Wayback snapshot $attempt/$total"
        fi

        if curl_download_file "$tmpfile" "$archive_url"; then
            mv "$tmpfile" "$srcdest_dir/$filename"
            return 0
        fi

        if [[ "$archive_url" =~ /web/([0-9]{14})id_/ ]]; then
            warning "Wayback snapshot download failed: ${BASH_REMATCH[1]}"
        else
            warning "Wayback snapshot download failed"
        fi

        rm -f "$tmpfile"
    done

    return 1
}

# Recover unreachable HTTP(S) sources from Wayback into a dedicated SRCDEST
try_wayback_source_fallback() {
    local srcdest_dir="$1"
    local recovered=0
    local entry
    local parsed=()
    local filename
    local url

    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue

        mapfile -t parsed < <(parse_source_entry "$entry")
        filename=${parsed[0]}
        url=${parsed[1]}

        [[ "$url" =~ ^https?:// ]] || continue
        [[ -n "$filename" ]] || continue
        [[ -s "$srcdest_dir/$filename" ]] && continue

        if source_url_is_reachable "$url"; then
            continue
        fi

        info "Source unavailable, checking Wayback: $filename"
        if download_wayback_source "$url" "$filename" "$srcdest_dir"; then
            success "Recovered source from Wayback: $filename"
            ((recovered++))
        else
            warning "Wayback has no usable archived copy for: $filename"
        fi
    done < <(collect_pkgbuild_sources)

    [[ $recovered -gt 0 ]]
}

# Verify sources first so failed downloads can be recovered before a full build
verify_sources_with_fallback() {
    local srcdest_dir="$1"
    local use_wayback_fallback="$2"
    shift
    shift
    local verify_flags=("$@")

    if run_makepkg_logged env SRCDEST="$srcdest_dir" makepkg "${verify_flags[@]}"; then
        return 0
    fi

    [[ "$use_wayback_fallback" == true ]] || return 1

    warning "Source verification failed"
    if ! try_wayback_source_fallback "$srcdest_dir"; then
        return 1
    fi

    info "Retrying source verification with recovered files..."
    run_makepkg_logged env SRCDEST="$srcdest_dir" makepkg "${verify_flags[@]}"
}

# Prepare sources and optionally retry with --skipchecksums after integrity failures
prepare_sources_for_build() {
    local srcdest_dir="$1"
    local use_wayback_fallback="$2"
    local makepkg_flags_name="$3"
    local verify_flags_name="$4"
    local -n makepkg_flags_ref="$makepkg_flags_name"
    local -n verify_flags_ref="$verify_flags_name"

    if verify_sources_with_fallback "$srcdest_dir" "$use_wayback_fallback" "${verify_flags_ref[@]}"; then
        return 0
    fi

    if [[ "$LAST_INTEGRITY_FAILURE" == true ]] && confirm "Skip all checksum verification and continue?"; then
        # shellcheck disable=SC2034 # nameref assignment updates the caller's makepkg flags
        makepkg_flags_ref=(--skipchecksums -si)
        verify_flags_ref=(--verifysource --skipchecksums)
        info "Will use --skipchecksums flag"
        verify_sources_with_fallback "$srcdest_dir" "$use_wayback_fallback" "${verify_flags_ref[@]}"
        return $?
    fi

    return 1
}

# Parse version from PKGBUILD content (accepts content via stdin or parameter)
# Sources PKGBUILD to evaluate dynamic version definitions (e.g., pkgver=$(cmd))
parse_pkgbuild_version() {
    local content="$1"

    [[ -z "$content" ]] && content=$(cat)

    local result
    result=$(
        source <(echo "$content") 2>/dev/null
        [[ -n "$pkgver" ]] && printf '%s' "${epoch:+$epoch:}${pkgver}-${pkgrel}"
    )

    if [[ -z "$result" || ! "$result" =~ -[0-9] ]]; then
        echo "?"
    else
        echo "$result"
    fi
}

# Ask user for yes/no confirmation
# Usage: confirm "Question?" [default]
# Returns: 0 for yes, 1 for no
confirm() {
    local prompt="$1"
    local default="${2:-N}"

    # Format prompt based on default
    [[ "$default" =~ ^[Yy]$ ]] && prompt="$prompt [Y/n] " || prompt="$prompt [y/N] "

    read -p "$prompt" -n 1 -r
    echo

    # Check reply (use default if empty)
    [[ "${REPLY:-$default}" =~ ^[Yy]$ ]]
}

# Check dependencies
check_dependencies() {
    local missing=()
    for cmd in git fzf makepkg curl; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        error "Missing dependencies: ${missing[*]}"
        error "Please install: sudo pacman -S git curl fzf base-devel"
        exit 1
    fi
}

# Check if official repository package
check_official_repo() {
    local package="$1"
    local repo
    repo=$(pacman -Si "$package" 2>/dev/null | grep -m1 '^Repository' | awk '{print $3}')

    # Check if package is from official repositories (core, extra, multilib, etc.)
    if [[ "$repo" =~ ^(core|extra|multilib|core-testing|extra-testing|multilib-testing)$ ]]; then
        warning "[$package] is an official repository package, not an AUR package"

        # Check if downgrade is installed
        if command -v downgrade &>/dev/null; then
            info "Detected downgrade tool, invoking for you..."
            echo
            exec sudo downgrade "$package"
        else
            error "Official packages require the downgrade tool"
            info "Please install downgrade first:"
            echo "  https://github.com/archlinux-downgrade/downgrade"
            echo "  https://aur.archlinux.org/packages/downgrade"
            exit 1
        fi
    fi
}

# Extract version from PKGBUILD file
get_pkgbuild_version() {
    [[ -f PKGBUILD ]] && parse_pkgbuild_version "$(cat PKGBUILD)" || echo "?"
}

# Main function
main() {
    local dev_mode=false
    local use_github=false
    local use_wayback_fallback=true
    local package=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version|-v)
                echo "aurpick ($(sha256sum "$0" | cut -c1-7))"
                exit 0
                ;;
            --dev)
                dev_mode=true
                shift
                ;;
            --github)
                use_github=true
                shift
                ;;
            --no-wayback)
                use_wayback_fallback=false
                shift
                ;;
            *)
                package="$1"
                shift
                ;;
        esac
    done

    # Check arguments
    if [[ -z "$package" ]]; then
        error "Usage: $0 [--dev] [--github] [--no-wayback] <package-name>"
        echo "Example: $0 yay"
        echo "         $0 --github yay"
        echo "Options:"
        echo "  --dev       Development mode (preserve temporary files)"
        echo "  --github    Use GitHub AUR mirror instead of aur.archlinux.org"
        echo "  --no-wayback Disable Wayback fallback for missing source files"
        echo "  --version   Show version information"
        exit 1
    fi

    # Check dependencies
    check_dependencies

    # Check official repository
    check_official_repo "$package"

    # Set working directory
    local work_dir="/tmp/aurpick-$package"

    # Setup cleanup trap (skip in dev mode)
    if [[ "$dev_mode" == false ]]; then
        trap 'rm -rf "$work_dir" 2>/dev/null' EXIT
    else
        info "Dev mode: temporary files will be preserved in $work_dir"
    fi

    # Clone or reuse repository
    if [[ "$dev_mode" == true && -d "$work_dir/.git" ]]; then
        info "Reusing existing repository in $work_dir..."
        cd "$work_dir" || {
            error "Failed to access directory $work_dir"
            exit 1
        }
        # Switch to appropriate branch based on source
        if [[ "$use_github" == true ]]; then
            git checkout -q "$package" 2>/dev/null || true
        else
            git checkout -q master 2>/dev/null || true
        fi
        git fetch --quiet 2>/dev/null || true
    else
        info "Fetching AUR repository for $package..."
        rm -rf "$work_dir"

        # Clone from appropriate source
        if [[ "$use_github" == true ]]; then
            git clone --branch "$package" --single-branch \
                "https://github.com/archlinux/aur.git" "$work_dir" || {
                error "Clone failed from GitHub mirror"
                error "Package branch may not exist or mirror is unavailable"
                exit 1
            }
        else
            git clone "https://aur.archlinux.org/$package.git" "$work_dir" || {
                error "Clone failed, package may not exist"
                exit 1
            }
        fi

        cd "$work_dir" || {
            error "Failed to access directory $work_dir"
            exit 1
        }

        # Check if repository has any commits (detect empty repository)
        if ! git rev-list --count HEAD >/dev/null 2>&1; then
            error "Package repository is empty or package does not exist"
            exit 1
        fi
    fi

    # Show warning for GitHub mirror usage
    if [[ "$use_github" == true ]]; then
        echo
        warning "Using GitHub AUR mirror (read-only experimental mirror)"
        echo
    fi

    # Get currently installed version
    local current_version=""
    if pacman -Q "$package" &>/dev/null; then
        current_version=$(pacman -Q "$package" 2>/dev/null | awk '{print $2}')
        info "Currently installed: $current_version"
    fi

    # Use fzf to select version (with streaming data)
    info "Loading version history (you can select while loading)..."

    # Random prompt tips
    local tips=(
        "Type to search • ESC/Ctrl+C/Ctrl+D to exit"
        "Use arrow keys to navigate • ESC to cancel"
        "Search by version or hash • Ctrl+C to quit"
        "Press Enter to select • Ctrl+D to abort"
        "Filter results by typing • ESC to exit"
    )
    local random_tip="${tips[$RANDOM % ${#tips[@]}]}"

    # Build header with current version info (fixed-width + tab-separated)
    local header_text
    header_text=$(printf "%-20s\t%-24s\t%s" "Version" "Time" "Git Hash")

    if [[ -n "$current_version" ]]; then
        header_text="$header_text"$'\n'"Currently installed: $current_version"
    else
        header_text="$header_text"$'\n'"No version matches installed"
    fi

    local selected
    selected=$(
        git log --format="%H %ai" | while IFS=' ' read -r hash date time; do
            # Use git show to read PKGBUILD without checking out (much faster)
            pkgbuild_content=$(git show "$hash:PKGBUILD" 2>/dev/null)

            # Extract version info from PKGBUILD content
            if [[ -n "$pkgbuild_content" ]]; then
                version=$(echo "$pkgbuild_content" | parse_pkgbuild_version)
                [[ -z "$version" || "$version" == "?-?" ]] && version="?"
            else
                version="?"
            fi

            short_hash=${hash:0:7}

            # Output formatted line (fixed-width for alignment, tab-separated for parsing)
            printf "%-20s\t%-24s\t%s\n" "$version" "$date $time" "$short_hash"
        done | \
        fzf --ansi \
            --prompt="$random_tip > " \
            --header="$header_text" \
            --preview="git -C $work_dir show --stat {-1} && \
                       echo && echo '━━━━━ PKGBUILD ━━━━━' && echo && \
                       git -C $work_dir show {-1}:PKGBUILD" \
            --preview-window=right:50%:wrap
    )

    if [[ -z "$selected" ]]; then
        warning "Operation cancelled"
        exit 0
    fi

    # Extract selected hash (using tab as delimiter, trim trailing spaces)
    local selected_hash
    local selected_version
    selected_version=$(echo "$selected" | cut -f1 | xargs)
    selected_hash=$(echo "$selected" | cut -f3)

    info "Switching to commit $selected_hash (version: $selected_version)..."
    git checkout "$selected_hash" || {
        error "Switch failed"
        exit 1
    }

    # Display version info to be built
    echo
    success "Switched to historical version:"
    echo "  Package: $package"
    echo "  Version: $selected_version"
    echo "  Commit: $selected_hash"
    echo

    # Ask if view PKGBUILD
    confirm "View PKGBUILD?" && less PKGBUILD

    local makepkg_flags=(-si)

    # Ask if continue building
    if ! confirm "Continue to build and install?"; then
        warning "Build cancelled"
        exit 0
    fi

    local srcdest_dir="$work_dir/.srcdest"
    local verify_flags=(--verifysource)
    mkdir -p "$srcdest_dir"

    if ! prepare_sources_for_build "$srcdest_dir" "$use_wayback_fallback" makepkg_flags verify_flags; then
        error "Source verification failed"
        exit 1
    fi

    # Build and install
    info "Building $package-$selected_version..."
    if SRCDEST="$srcdest_dir" makepkg "${makepkg_flags[@]}"; then
        echo
        success "Installation complete!"
        echo
        info "To prevent auto-updates, add to /etc/pacman.conf:"
        echo "  IgnorePkg = $package"
    else
        error "Build failed"
        exit 1
    fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
